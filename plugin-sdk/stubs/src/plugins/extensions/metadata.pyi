from _typeshed import Incomplete
from collections.abc import Callable as Callable
from datetime import date
from pydantic import BaseModel
from src.plugins.contracts import PluginExtension as PluginExtension
from typing import Literal

METADATA_SOURCE_EXTENSION_KEY: str
METADATA_SOURCE_HOST_API_VERSION: int

class PluginMetadataActor(BaseModel):
    name: str = ...
    alias_names: list[str] = ...
    gender: int = ...

class PluginMovieMetadata(BaseModel):
    movie_number: str = ...
    title: str = ...
    release_date: date = ...
    duration_minutes: int = ...
    cover_image_path: str = ...
    summary: str = ...
    maker_name: str | None = ...
    director_name: str | None = ...
    series_name: str | None = ...
    actors: list[PluginMetadataActor] = ...
    tags: list[str] = ...
    plot_image_paths: list[str] = ...
    source_url: str | None = ...
    source_id: str | None = ...
    @classmethod
    def validate_date(cls, value): ...
    @classmethod
    def empty_lists(cls, value): ...
    @classmethod
    def empty_summary(cls, value): ...
    @classmethod
    def clean_tags(cls, value): ...

class PluginActorRef(BaseModel):
    actor_id: int = ...
    name: str = ...
    alias_names: list[str] = ...
    gender: int = ...
    @classmethod
    def empty_alias_names(cls, value): ...
    @classmethod
    def clean_alias_names(cls, value): ...

class PluginActorMovieQuery(BaseModel):
    actor: PluginActorRef = ...
    cursor: str | None = ...
    mode: Literal['incremental', 'full'] = ...
    @classmethod
    def empty_cursor(cls, value): ...

class PluginActorMoviePage(BaseModel):
    movie_numbers: list[str] = ...
    next_cursor: str | None = ...
    @classmethod
    def empty_next_cursor(cls, value): ...
    @classmethod
    def empty_movie_numbers(cls, value): ...
    @classmethod
    def clean_movie_numbers(cls, value): ...

class PluginMetadataSource(BaseModel):
    fetch_movie: Callable[[str], PluginMovieMetadata | None] = ...
    fetch_actor_movies: Callable[[PluginActorMovieQuery], PluginActorMoviePage | None] | None = ...

def validate_metadata_extension(*, plugin_id: str, extension: PluginExtension) -> PluginMetadataSource: ...
