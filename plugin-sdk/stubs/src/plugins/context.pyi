@dataclass(frozen=True, init=False)
class PluginContext:
    plugin_id: str
    settings: Mapping[str, Any]
    def __init__(self, plugin_id: str, settings: Mapping[str, Any], data_dir: Path, plugin_root: Path | None = None) -> None: ...
    def ensure_data_dir(self) -> Path: ...
    @property
    def data_dir(self) -> Path: ...
    @property
    def i18n(self) -> PluginI18n: ...
    @property
    def actors(self) -> ActorApi: ...
    @property
    def movies(self) -> MovieApi: ...
    @property
    def media(self) -> MediaApi: ...
    @property
    def downloads(self) -> PluginDownloadService: ...
    @property
    def imports(self) -> ImportApi: ...
    @property
    def videos(self) -> VideoApi: ...
    @property
    def subscriptions(self) -> SubscriptionApi: ...
    @property
    def notifications(self) -> NotificationApi: ...
    @property
    def collections(self) -> CollectionApi: ...
    @property
    def subtitles(self) -> SubtitleApi: ...
    @staticmethod
    def build_catalog_import_service(): ...
    def import_movie_by_number(self, movie_number: str, *, force_subscribed: bool = False) -> MovieSnapshot: ...
    def list_existing_movie_numbers(self) -> set[str]: ...
    def import_subtitle(self, movie_number: str, content: bytes, filename: str, language: str | None = None): ...
    def sync_ranking_sources(self, progress_callback=None) -> dict[str, int]: ...
    def sync_ranking_board(self, source_key: str, board_key: str, period: str | None = None) -> dict[str, int | str]: ...
    @staticmethod
    def get_task_logger(name: str): ...
