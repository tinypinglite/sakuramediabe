from _typeshed import Incomplete
from collections.abc import Callable as Callable
from pydantic import BaseModel
from typing import Any

class JobExecutionError(ValueError): ...

class JobDefinition(BaseModel):
    task_key: str = ...
    log_name: str = ...
    cli_name: str = ...
    cli_help: str = ...
    cli_help_i18n: dict[str, str] = ...
    cron_setting: str | None = ...
    default_cron: str | None = ...
    business_recovery: Callable[[], dict[str, int]] | None = ...
    manual_trigger_allowed: bool = ...
    manual_only: bool = ...
    params_schema: type[BaseModel] | None = ...
    handler: Callable[[Any, dict[str, Any]], Any] = ...
    lane: str = ...
    notify_result: bool = ...
    plugin_id: str | None = ...
    def build_executor(self, raw_params: dict[str, Any] | None): ...
