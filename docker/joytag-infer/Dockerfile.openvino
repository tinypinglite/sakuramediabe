FROM python:3.10-slim-bookworm

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    ocl-icd-libopencl1 \
    intel-opencl-icd \
    libze1 \
    libdrm2 \
    libglib2.0-0 \
    libtbb12 \
    && rm -rf /var/lib/apt/lists/*

# 说明:曾尝试 LD_PRELOAD=libjemalloc.so.2 进一步压缩驻留内存,但和 OpenVINO 的 C++ 依赖
# (TBB / oneDNN)存在分配器交叉持有问题,启动即触发 `free(): invalid size` → SIGSEGV。
# 现有优化(原生 OV + 静态 batch=1 + FP16 IR)已经把内存从 ~3GB 压到 ~500-700MB,
# 放弃 jemalloc 只损失 ~100-200MB 的边际收益,不再引入。

COPY docker/joytag-infer/requirements.openvino.txt /tmp/requirements.openvino.txt
COPY docker/joytag-infer/requirements.base.txt /tmp/requirements.base.txt
RUN python3 -m pip install --no-cache-dir -r /tmp/requirements.openvino.txt

COPY docker/joytag-infer/app /app

ENV PYTHONPATH=/app
EXPOSE 8001

CMD ["python3", "-m", "joytag_infer"]
